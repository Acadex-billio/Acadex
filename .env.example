# Frontend Configuration
REACT_APP_API_URL=https://acadex-hng2.onrender.com

# CORS Configuration - List of allowed origins (comma-separated)
CORS_ORIGIN=https://hnd-platform.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Backend Environment
NODE_ENV=production

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hnd_platform

# Authentication & Security
JWT_SECRET=your-64-character-random-secret-key-minimum-32-characters-required
JWT_EXPIRES_IN=7d
SESSION_SECRET=your-32-character-random-session-secret-key

# Email Service (Resend)
RESEND_API_KEY=your-resend-api-key

# External APIs
GOOGLE_CSE_API_KEY=your-google-custom-search-api-key
GOOGLE_CSE_SEARCH_ENGINE_ID=your-google-search-engine-id

# Admin Configuration
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Redis Configuration (Optional but recommended for production)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server Port
PORT=5000
